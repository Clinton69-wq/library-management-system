{
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.7.3"
    }
  },
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/database/(.*)",
      "status": 403
    },
    {
      "src": "/config/(.*)",
      "status": 403
    },
    {
      "src": "/includes/(.*)",
      "status": 403
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ]
}
