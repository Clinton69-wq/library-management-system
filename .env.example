# ===================================================
# ApexLib System Environment Configuration
# ===================================================

# Database Connection (Defaults to XAMPP for local development)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=library_db
DB_USER=root
DB_PASS=

# Environment & Base URL (Leave empty or set to root '/' on Vercel)
APP_ENV=production
APP_BASE_URL=

# Two-Step Verification (OTP) Demo Mode (1 = show OTP code banner in UI, 0 = production email only)
OTP_DEMO_MODE=1

# Cloudflare R2 Vault Settings
CF_ACCOUNT_ID=cf_acc_98a72e41c09b882
CF_R2_BUCKET=apex-library-r2-vault
CF_REGION=auto
CF_ZONE_ID=cf_zone_3049284028304928

# SMTP Email Dispatch (Optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=ApexLib Cloud Library System

