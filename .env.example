# ===================================================
# ApexLib System Environment Configuration
# ===================================================

# Database Connection (use a remotely reachable MySQL/MariaDB host in production)
DB_HOST=your-mysql-host
DB_PORT=3306
DB_NAME=library_db
DB_USER=your-database-user
DB_PASS=replace-with-database-password

# Use '/' at the domain root on Vercel; use '/libary' for local XAMPP.
APP_ENV=production
APP_BASE_URL=/

# Disable the demo OTP banner in production; configure SMTP below to deliver OTPs
OTP_DEMO_MODE=0

# Cloudflare R2 display/endpoint settings (optional)
CF_ACCOUNT_ID=
CF_R2_BUCKET=
CF_REGION=auto
CF_ZONE_ID=
CF_ENDPOINT_HOST=

# Set this to the existing value from config/config.php to preserve migrated password hashes.
# Keep it private; changing it invalidates existing users' password hashes.
SYSTEM_PEPPER=replace-with-the-existing-system-pepper

# SMTP Email Dispatch (Optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=ApexLib Cloud Library System
